# Kredensial untuk pengujian end-to-end (Playwright).
#
# Salin menjadi .env.test lalu isi dengan basis data PENGUJIAN — bukan produksi.
# Suite e2e menulis data sungguhan (membuat santri, sesi presensi, izin), jadi
# e2e/jaga.ts menolak berjalan bila DATABASE_URL tidak mengandung salah satu
# penanda: simhaq_test, akhiran _test, localhost, 127.0.0.1, atau awalan test.
#
# Di Neon cukup buat basis data terpisah pada proyek yang sama, lalu siapkan
# skemanya:  npx prisma db push  &&  npx prisma db seed

DATABASE_URL="postgresql://pengguna:sandi@host.neon.tech/simhaq_test?sslmode=verify-full"

# Rahasia sesi khusus pengujian — jangan pakai nilai produksi.
AUTH_SECRET="uji-e2e-simhaq-ganti-dengan-32-karakter-acak"

# Biarkan false agar perilaku pemisahan gender ikut teruji.
ADMIN_LINTAS_GENDER="false"
