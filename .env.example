# --- Basis data -----------------------------------------------------------
# Development lokal (SQLite, tanpa instalasi apa pun):
DATABASE_URL="file:./dev.db"
#
# Produksi (PostgreSQL, mis. Neon / Supabase / Vercel Postgres).
# Ganti juga `provider` pada prisma/schema.prisma menjadi "postgresql".
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Keamanan sesi --------------------------------------------------------
# Wajib diisi. Buat nilai acak, misalnya:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# --- Opsional -------------------------------------------------------------
# Izinkan admin/pimpinan melihat data lintas gender (default: tidak).
ADMIN_LINTAS_GENDER="false"

# Titik pusat pesantren untuk pembatasan lokasi presensi (opsional).
NEXT_PUBLIC_LOKASI_LAT="-6.893056"
NEXT_PUBLIC_LOKASI_LNG="107.590278"

# Zona waktu runtime server. Kosongkan untuk memakai Asia/Jakarta.
# Runtime hosting umumnya UTC; nilai ini disetel di src/instrumentation.ts
# karena Vercel tidak mengizinkan variabel lingkungan bernama TZ.
ZONA_WAKTU="Asia/Jakarta"
